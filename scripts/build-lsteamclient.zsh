#!/bin/zsh
# Copyright 2026, Nick Kennedy
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Build Proton's lsteamclient for a CrossOver Wine tree, so Windows games in Wine use
# the macOS Steam client (steamclient.dylib) instead of a Windows Steam in the prefix.
# See docs/lsteamclient.md.
#
# Valve's lsteamclient (Steamworks SDK licence, not redistributed here) is fetched from
# ValveSoftware/Proton at PROTON_COMMIT and checked against TREE_DIGEST, then
# patches/lsteamclient/*.patch are applied. The PE half (lsteamclient.dll) is built by
# the Wine tree's make. CrossOver 26.3's makedep (Wine 11.0) cannot build C++ unix
# sources, so the unix half (lsteamclient.so, 219 C++ files) is compiled and linked
# here with the tree's own unix flags.
#
# The game also needs the ntdll redirect, patches/crossover/0007-ntdll-lsteamclient-redirect.patch,
# built into the same tree (make dlls/ntdll/ntdll.so dlls/ntdll/x86_64-windows/ntdll.dll).
#
# Usage: [WINE_SRC=...] [WINE_BUILD=...] [OUT=...] build-lsteamclient.zsh
#   WINE_SRC    CrossOver Wine source (default ~/Code/wine-crossover/sources/wine)
#   WINE_BUILD  its configured x86_64 build tree (default ~/Code/wine-crossover/build)
#   OUT         where lsteamclient.dll and lsteamclient.so are copied
#               (default build-in-process/lsteamclient in this repository)
#   SDKROOT     macOS SDK for the unix half (default: the 26.5 Command Line Tools SDK,
#               which the rig's Wine is built with)
set -euo pipefail
repo=${0:A:h:h}
WINE_SRC=${WINE_SRC:-$HOME/Code/wine-crossover/sources/wine}
WINE_BUILD=${WINE_BUILD:-$HOME/Code/wine-crossover/build}
OUT=${OUT:-${repo}/build-in-process/lsteamclient}
export SDKROOT=${SDKROOT:-/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk}
# proton_11.0, 2026-10-09
PROTON_COMMIT=${PROTON_COMMIT:-bc896217ffcd67f892f952b010f898fe7bd0f0a1}
# sha256 over the sha256 of each extracted file, sorted by path (tarball bytes can vary)
TREE_DIGEST=${TREE_DIGEST:-0f0974a9e4b99cc203213c3c6c7e6d0068c54b36b309b60b7efa60b80484f77a}
jobs=${JOBS:-$(sysctl -n hw.ncpu)}

[[ -f ${WINE_SRC}/dlls/ntdll/loader.c && -f ${WINE_BUILD}/config.status ]] || {
  print -u2 "Need a CrossOver Wine source (${WINE_SRC}) and configured build (${WINE_BUILD})"; exit 1
}
grep -q MWXR_LSTEAMCLIENT "${WINE_SRC}/dlls/ntdll/loader.c" ||
  print -u2 "warning: ${WINE_SRC} lacks the ntdll lsteamclient redirect (patches/crossover/0007); games will not use lsteamclient"

# 1. Valve's sources, pinned and checked
cache=${OUT}/src/proton-${PROTON_COMMIT}
if [[ ! -d ${cache} ]]; then
  mkdir -p "${OUT}/src"
  print "Fetching lsteamclient from Proton ${PROTON_COMMIT}"
  rm -rf "${cache}.part"; mkdir -p "${cache}.part"
  curl -fsSL "https://codeload.github.com/ValveSoftware/Proton/tar.gz/${PROTON_COMMIT}" |
    tar xzf - -C "${cache}.part" --strip-components=2 "*/lsteamclient/"
  mv "${cache}.part" "${cache}"
fi
digest=$(cd "${cache}" && find . -type f | LC_ALL=C sort | xargs shasum -a 256 | shasum -a 256 | cut -d' ' -f1)
[[ ${digest} == ${TREE_DIGEST} ]] || { print -u2 "lsteamclient sources do not match TREE_DIGEST (${digest})"; exit 1; }

# 2. Assemble the module in the Wine source: Valve's files, our patches, a PE-only Makefile.in
dll=${WINE_SRC}/dlls/lsteamclient
rm -rf "${dll}"; cp -R "${cache}" "${dll}"
for p in "${repo}"/patches/lsteamclient/*.patch(N); do
  patch -s -p1 -d "${dll}" < "${p}"
done
c_sources=(${dll}/*.c(:t))
cpp_sources=(${dll}/*.cpp(:t))
{
  print "# Generated by macos-wine-xr scripts/build-lsteamclient.zsh: the PE half only;"
  print "# the unix half (lsteamclient.so) is built by that script."
  grep -E '^(MODULE|IMPORTS|EXTRADEFS)[[:space:]]*=' "${cache}/Makefile.in"
  print "\nSOURCES = \\"
  for f in ${c_sources}; do print "\t${f} \\"; done
  print "\t\$(NULL)"
} > "${dll}/Makefile.in"

# 3. Register the directory with the build tree, without rerunning configure's tests
cd "${WINE_BUILD}"
if ! grep -q $'^\tdlls/lsteamclient \\\\$' config.status; then
  print "Registering dlls/lsteamclient in ${WINE_BUILD}/config.status"
  cp -p config.status config.status.pre-lsteamclient
  sed -i '' $'s#^\tdlls/lz32 \\\\$#\tdlls/lsteamclient \\\\\\\n\tdlls/lz32 \\\\#' config.status
  grep -q $'^\tdlls/lsteamclient \\\\$' config.status || { print -u2 "could not register dlls/lsteamclient"; exit 1; }
  cp -p include/config.h include/config.h.pre-lsteamclient
  ./config.status > /dev/null
  # config.status rewrites config.h; keep the old timestamp when nothing changed, or the
  # whole tree would rebuild
  if cmp -s <(tail -n +2 include/config.h) <(tail -n +2 include/config.h.pre-lsteamclient); then
    touch -r include/config.h.pre-lsteamclient include/config.h include/stamp-h
  fi
  rm -f include/config.h.pre-lsteamclient
fi

# 4. The PE half
make -j"${jobs}" dlls/lsteamclient/x86_64-windows/lsteamclient.dll

# 5. The unix half
obj=${WINE_BUILD}/dlls/lsteamclient/unix
mkdir -p "${obj}"
extradefs=$(sed -n 's/^EXTRADEFS[[:space:]]*=[[:space:]]*//p' "${cache}/Makefile.in")
cxx=(clang++ -arch x86_64 -m64 -std=c++17 -c -I"${WINE_BUILD}/dlls/lsteamclient" -I"${dll}"
  -I"${WINE_BUILD}/include" -I"${WINE_SRC}/include" -D__WINESRC__ -DWINE_UNIX_LIB ${=extradefs}
  -pipe -fcf-protection=none -fvisibility=hidden -fno-stack-protector -fno-strict-aliasing
  -gdwarf-4 -fPIC -fasynchronous-unwind-tables -g -O2 -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0
  -Wno-deprecated-declarations)
print "Compiling ${#cpp_sources} unix sources"
# A generated makefile gives parallel, incremental compiles with proper failure handling.
{
  print "CXXCMD = ${cxx[*]}"
  print -n "all:"
  for src in ${cpp_sources}; do print -n " ${obj}/${src:r}.o"; done
  print
  for src in ${cpp_sources}; do
    print "${obj}/${src:r}.o: ${dll}/${src} ${dll}/unix_private.h"
    print "\t\$(CXXCMD) -o \$@ \$<"
  done
} > "${obj}/Makefile"
make -s -j"${jobs}" -f "${obj}/Makefile"
clang++ -arch x86_64 -m64 -o dlls/lsteamclient/lsteamclient.so -dynamiclib \
  -install_name @rpath/lsteamclient.so -Wl,-rpath,@loader_path/ \
  "${obj}"/*.o dlls/ntdll/ntdll.so

# 6. Results, and the Steam stand-in that starts games (src/windows/steam_stand_in.c)
mkdir -p "${OUT}"
cp dlls/lsteamclient/x86_64-windows/lsteamclient.dll dlls/lsteamclient/lsteamclient.so "${OUT}/"
x86_64-w64-mingw32-gcc -municode -O2 -Wall -o "${OUT}/mwxr-steam.exe" "${repo}/src/windows/steam_stand_in.c"
print "Built ${OUT}/lsteamclient.dll, lsteamclient.so and mwxr-steam.exe"
