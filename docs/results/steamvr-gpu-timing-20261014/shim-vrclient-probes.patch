+// Diagnostic (MWXR_OPENVR_SHIM_TRACE_SUBMIT=1): one-shot breakpoints on every
+// basic block of SteamVR's shared-texture Submit function (vrclient_x64.dll RVA
+// 0x153d20, the installed build only) to find which path skips its GPU-timing
+// setup. Each int3 is removed on its first hit, which is recorded in order.
+constexpr size_t kTraceBlocks = sizeof(kSubmitTraceBlocks) / sizeof(kSubmitTraceBlocks[0]);
+unsigned char g_traceOriginal[kTraceBlocks];
+volatile LONG g_traceOrder[kTraceBlocks];
+volatile LONG g_traceSequence = 0;
+uint64_t g_traceBase = 0;
+
+LONG CALLBACK
+TraceHandler(EXCEPTION_POINTERS *info)
+{
+	if (info->ExceptionRecord->ExceptionCode != EXCEPTION_BREAKPOINT || !g_traceBase) {
+		return EXCEPTION_CONTINUE_SEARCH;
+	}
+	uint64_t rva = (uint64_t)info->ExceptionRecord->ExceptionAddress - g_traceBase;
+	size_t lo = 0, hi = kTraceBlocks;
+	while (lo < hi) {
+		size_t mid = (lo + hi) / 2;
+		if (kSubmitTraceBlocks[mid] < rva) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	if (lo == kTraceBlocks || kSubmitTraceBlocks[lo] != rva) {
+		return EXCEPTION_CONTINUE_SEARCH;
+	}
+	unsigned char *at = (unsigned char *)(g_traceBase + rva);
+	if (*at == 0xcc) {
+		*at = g_traceOriginal[lo];
+		FlushInstructionCache(GetCurrentProcess(), at, 1);
+		InterlockedCompareExchange(&g_traceOrder[lo], InterlockedIncrement(&g_traceSequence), 0);
+	}
+	info->ContextRecord->Rip = (DWORD64)at;
+	return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+DWORD WINAPI
+ReportTrace(void *)
+{
+	for (int report = 0; report < 3; ++report) {
+		Sleep(report == 0 ? 30000 : 30000);
+		char line[2048];
+		int written = snprintf(line, sizeof(line), "submit trace %d: %ld hits:", report, g_traceSequence);
+		for (size_t i = 0; i < kTraceBlocks; ++i) {
+			if (!g_traceOrder[i]) {
+				continue;
+			}
+			if (written > (int)sizeof(line) - 24) {
+				Log("%s\n", line);
+				written = snprintf(line, sizeof(line), "submit trace %d (cont):", report);
+			}
+			written += snprintf(line + written, sizeof(line) - written, " %x@%ld", kSubmitTraceBlocks[i],
+			                    g_traceOrder[i]);
+		}
+		Log("%s\n", line);
+	}
+	return 0;
+}
+
+void
+ArmSubmitTrace()
+{
+	static LONG armed = 0;
+	const char *value = getenv("MWXR_OPENVR_SHIM_TRACE_SUBMIT");
+	if (!value || strcmp(value, "1") || InterlockedExchange(&armed, 1)) {
+		return;
+	}
+	HMODULE vrclient = GetModuleHandleA("vrclient_x64.dll");
+	const unsigned char prologue[] = {0x4c, 0x89, 0x44, 0x24, 0x18, 0x55, 0x53, 0x56,
+	                                  0x41, 0x54, 0x41, 0x55, 0x41, 0x57, 0x48, 0x8d};
+	if (!vrclient || memcmp((const unsigned char *)vrclient + 0x153d20, prologue, sizeof(prologue))) {
+		Log("submit trace: vrclient_x64.dll missing or a different build; not armed\n");
+		return;
+	}
+	uint64_t base = (uint64_t)vrclient;
+	DWORD old;
+	if (!VirtualProtect((void *)(base + 0x153000), 0x6000, PAGE_EXECUTE_READWRITE, &old)) {
+		Log("submit trace: VirtualProtect failed %lu\n", GetLastError());
+		return;
+	}
+	g_traceBase = base;
+	AddVectoredExceptionHandler(1, TraceHandler);
+	for (size_t i = 0; i < kTraceBlocks; ++i) {
+		unsigned char *at = (unsigned char *)(base + kSubmitTraceBlocks[i]);
+		g_traceOriginal[i] = *at;
+		*at = 0xcc;
+	}
+	FlushInstructionCache(GetCurrentProcess(), (void *)(base + 0x153000), 0x6000);
+	Log("submit trace: armed %zu blocks\n", kTraceBlocks);
+	CloseHandle(CreateThread(nullptr, 0, ReportTrace, nullptr, 0, nullptr));
+}
