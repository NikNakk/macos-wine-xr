+// Diagnostic: find every live object with SteamVR's compositor-client vtable
+// (RVA 0x3b4db8) and log its GPU-timing state, once, from a background thread.
+DWORD WINAPI
+ScanClients(void *)
+{
+	Sleep(20000);
+	HMODULE vrclient = GetModuleHandleA("vrclient_x64.dll");
+	if (!vrclient) {
+		return 0;
+	}
+	const uint64_t vptr = (uint64_t)vrclient + 0x3b4db8;
+	MEMORY_BASIC_INFORMATION mbi;
+	unsigned char *address = nullptr;
+	int found = 0;
+	while (VirtualQuery(address, &mbi, sizeof(mbi)) && found < 16) {
+		unsigned char *region = (unsigned char *)mbi.BaseAddress;
+		bool readable = mbi.State == MEM_COMMIT && !(mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) &&
+		                (mbi.Protect & (PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READ |
+		                                PAGE_EXECUTE_READWRITE));
+		if (readable && mbi.RegionSize >= 0x1400) {
+			for (size_t at = 0; at + 0x1400 <= mbi.RegionSize; at += 8) {
+				if (*(const uint64_t *)(region + at) != vptr) {
+					continue;
+				}
+				const unsigned char *o = region + at;
+				uint64_t device = *(const uint64_t *)(o + 0xe00);
+				uint32_t frame = *(const uint32_t *)(o + 0xd68 + 0x70);
+				uint32_t count = *(const uint32_t *)(o + 0xd68 + 0x74);
+				float pre = *(const float *)(o + 0x130c), post = *(const float *)(o + 0x1310);
+				Log("client object %p (rva 0x%llx in vrclient? %d): device 0x%llx timing frame %u count %u pre %.2f "
+				    "post %.2f\n", o, (unsigned long long)(o - (const unsigned char *)vrclient),
+				    o > (const unsigned char *)vrclient && o < (const unsigned char *)vrclient + 0x500000,
+				    (unsigned long long)device, frame, count, pre, post);
+				++found;
+			}
+		}
+		address = region + mbi.RegionSize;
+	}
+	Log("client object scan done: %d found\n", found);
+	return 0;
 }
 
