// The macos-wine-xr Steam Play tool (docs/steam-play.md). The key must match the folder
// it is installed in (compatibilitytools.d/macos-wine-xr-proton) and the launcher's mapping.
// Steam maps Windows Steam Cloud folders into compatdata/<appid>/pfx only for a tool whose
// name contains "proton" (docs/steam-play.md, Steam Cloud), hence the name.
"compatibilitytools"
{
	"compat_tools"
	{
		"macos-wine-xr-proton"
		{
			"install_path"	"."
			"display_name"	"macos-wine-xr (Wine + DXMT + OpenXR)"
			"from_oslist"	"windows"
			"to_oslist"	"macos"
		}
	}
}
