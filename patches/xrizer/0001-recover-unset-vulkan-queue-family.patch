+#[cfg(test)]
+mod queue_family_recovery_tests {
+    use super::*;
+    #[test]
+    fn recover_only_an_unambiguous_matching_queue() {
+        let family = vk::QueueFamilyProperties {
+            queue_flags: vk::QueueFlags::GRAPHICS, queue_count: 1, ..Default::default()
+        };
+        let queue = vk::Queue::from_raw(7);
+        assert_eq!(resolve_queue_family_index(&[family], u32::MAX, queue, |f, i| {
+            assert_eq!((f, i), (0, 0)); queue
+        }), Some(0));
+        assert_eq!(resolve_queue_family_index(&[family], u32::MAX, queue, |_, _| vk::Queue::from_raw(8)), None);
+        assert_eq!(resolve_queue_family_index(&[family, family], u32::MAX, queue, |_, _| panic!("must not probe uncreated queues")), None);
+        let multiple = vk::QueueFamilyProperties { queue_count: 2, ..family };
+        assert_eq!(resolve_queue_family_index(&[multiple], u32::MAX, queue, |_, _| panic!("must not probe uncreated queues")), None);
+        assert_eq!(resolve_queue_family_index(&[family], 0, queue, |_, _| panic!("valid hint needs no recovery")), Some(0));
+    }
