+
+/* Retain ownership history without per-frame file writes. Only sampled
+ * timeouts/errors dump it, so a capture can distinguish a long-held owner
+ * from repeated acquisitions by competing processes. Server access is serial. */
+static void mutex_trace( struct d3dkmt_mutex *mutex, const char *operation,
+                         unsigned int key, unsigned int status )
+{
+    struct keyed_wait *wait;
+    struct mutex_history *record = &mutex->history[mutex->history_count++ % MUTEX_HISTORY_SIZE];
+    unsigned int i, count;
+    record->tick_us = monotonic_counter() / 10;
+    record->fence = mutex->fence_value;
+    record->held_us = mutex->owner ? record->tick_us - mutex->owned_since_us : 0;
+    record->pid = current ? current->process->id : 0;
+    record->tid = current ? current->id : 0;
+    record->owner_pid = mutex->owner ? mutex->owner->process->id : 0;
+    record->owner_tid = mutex->owner ? mutex->owner->id : 0;
+    record->operation = operation;
+    record->key = key;
+    record->released_key = mutex->key_value;
+    record->status = status;
+    record->waiters = 0;
+    record->queued_pid = record->queued_tid = 0;
+    LIST_FOR_EACH_ENTRY( wait, &mutex->waits, struct keyed_wait, entry ) record->waiters += wait->waiters;
+    if (status != STATUS_TIMEOUT && status != STATUS_INVALID_PARAMETER && status != STATUS_ABANDONED) return;
+    if (++mutex->timeout_count > 3 && mutex->timeout_count % 128) return;
+    fprintf( stderr, "mwxr-keyed-history handle=%#x sample=%u records=%u\n", mutex->base.global,
+             mutex->timeout_count, mutex->history_count < MUTEX_HISTORY_SIZE ? mutex->history_count : MUTEX_HISTORY_SIZE );
+    count = mutex->history_count < MUTEX_HISTORY_SIZE ? mutex->history_count : MUTEX_HISTORY_SIZE;
+    for (i = mutex->history_count - count; i != mutex->history_count; ++i)
+    {
+        record = &mutex->history[i % MUTEX_HISTORY_SIZE];
+        fprintf( stderr, "mwxr-keyed tick_us=%llu handle=%#x op=%s pid=%u tid=%u owner_pid=%u owner_tid=%u "
+                 "held_us=%llu key=%u released_key=%u fence=%llu status=%#x waiters=%u queued_pid=%u queued_tid=%u\n",
+                 (unsigned long long)record->tick_us, mutex->base.global, record->operation,
+                 record->pid, record->tid, record->owner_pid, record->owner_tid,
+                 (unsigned long long)record->held_us, record->key, record->released_key,
+                 (unsigned long long)record->fence, record->status, record->waiters, record->queued_pid, record->queued_tid );
+    }
+}
 
