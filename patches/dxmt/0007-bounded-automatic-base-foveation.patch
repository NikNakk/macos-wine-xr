+      values[p->width+i]=fminf(fmaxf(y,.5f),physical.height-.5f);
+    }
+    p->result.map=(obj_handle_t)map;p->result.forward=(obj_handle_t)xy;p->result.pipeline=(obj_handle_t)pipeline;
