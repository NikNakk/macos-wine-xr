+      return VK_NULL_HANDLE;
+   /* Between two foveated images of one size the layouts agree: copy as stored. */
+   if (dst && dst->implicit_fdm && dst->vk.extent.width == src->vk.extent.width &&
+       dst->vk.extent.height == src->vk.extent.height)
+      return VK_NULL_HANDLE;
