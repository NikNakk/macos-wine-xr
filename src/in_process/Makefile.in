# For integration into a Wine tree. The standalone prototype currently uses
# scripts/build-in-process-gate.zsh and generates the listed thunk sources.
MODULE = wineopenxr.dll
UNIXLIB = wineopenxr.so
IMPORTS = kernel32
UNIX_LIBS = -lopenxr_loader
SOURCES = \
	openxr.c \
	openxr_loader.c \
	openxr_thunks.c \
	loader_thunks.c
